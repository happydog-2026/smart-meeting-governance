# 复制为 .env 后按需修改。.env 不要提交到仓库。

# ===== 语音识别(ASR)=====
# 模型大小:tiny / base / small / medium / large-v3
# 中文会议建议 small 起步,效果不够再升 medium
WHISPER_MODEL=small

# 设备:cuda / cpu。默认 cpu(RTX 50 系 Blackwell 暂不支持,见 config.py 注释)
WHISPER_DEVICE=cpu

# 计算精度:cuda 用 float16,int8_float16;cpu 用 int8 / float32
# 留空则按设备自动选择
WHISPER_COMPUTE_TYPE=

# 模型下载源。国内网络建议保留镜像
HF_ENDPOINT=https://hf-mirror.com

# 模型缓存目录(留空则用 HuggingFace 默认缓存)
# 比赛现场断网时,提前下载好模型到本地这个目录
WHISPER_MODEL_DIR=

# ===== LLM(DeepSeek,OpenAI 兼容接口)=====
# 说明:网页端(web.py)只认侧边栏里用户自己填的 key,不再读这里的 .env;
# 下面的三项仅用于命令行脚本(scripts/pipeline.py 等)在开发者本地跑。
LLM_API_KEY=sk-你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 本地 Ollama(网页端 LLM 留空时的免费兜底,免 key)=====
# 需本机已安装并启动 Ollama(ollama.com)并拉取模型,如 `ollama pull qwen2.5:3b`。
# 网页端侧边栏 LLM key 留空时,自动回退到这里;命令行脚本不用它。
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# ===== 翻译(百度翻译 API,可选)=====
# 在 https://fanyi-api.baidu.com 注册应用获取 appid 和密钥。
# 配置后翻译走百度免费额度(省 LLM token);留空则翻译退回 LLM。
BAIDU_TRANSLATE_APPID=
BAIDU_TRANSLATE_KEY=

# 实时语音转写(讯飞 rtasr)不走 .env:请在运行后到网页左侧「🔊 实时转写 (讯飞)」
# 填你自己的 AppID / 接口密钥(会自动记住到本地)。留空则「实时字幕」回退 Web Speech API。
